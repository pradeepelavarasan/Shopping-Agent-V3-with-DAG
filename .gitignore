# Secrets — NEVER commit
.env
.env.local

# Local runtime state — regenerated on each run
code/state/sessions/*/
!code/state/sessions/.gitkeep
code/sandbox/*.txt
gateway/*.db
gateway/usage.json

# Virtual environments
.venv/
**/.venv/

# Temp / scratch dirs
.temp/
**/.temp/
gateway/tests/

# Build / cache artifacts
**/__pycache__/
**/*.pyc
uv.lock
**/uv.lock
**/.pytest_cache/

# macOS
.DS_Store
**/.DS_Store

# Editors
.vscode/
.idea/
